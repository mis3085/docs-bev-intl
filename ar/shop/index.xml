        &lt;a class=&#34;group-hover:text-primary-300 dark:group-hover:text-neutral-700 !no-underline&#34; href=&#34;#%d8%ad%d9%84%d9%88%d9%84-%d8%b4%d8%a7%d9%85%d9%84%d8%a9-%d9%84%d9%85%d9%82%d8%a7%d8%a8%d8%b6-%d8%a7%d9%84%d8%af%d8%b1%d8%a7%d8%ac%d8%a9-%d9%88%d8%a7%d9%84%d8%a5%d9%83%d8%b3%d8%b3%d9%88%d8%a7%d8%b1%d8%a7%d8%aa&#34; aria-label=&#34;رابط&#34;&gt;#&lt;/a&gt;
